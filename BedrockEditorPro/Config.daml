<ArcGIS defaultAssembly="BedrockEditorPro.dll" defaultNamespace="BedrockEditorPro" xmlns="http://schemas.esri.com/DADF/Registry" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://schemas.esri.com/DADF/Registry file:///C:/Users/ghuotvez/AppData/Local/Programs/ArcGIS/Pro/bin/ArcGIS.Desktop.Framework.xsd">
  <AddInInfo id="{c4ac06a4-3afa-4bf5-ad80-8080d10b68f3}" version="4.0.0" desktopVersion="3.5.57366" product="ArcGISPro">
    <Name>GSC Bedrock Project</Name>
    <Description>Bedrock Data Management Tools</Description>
    <Image>Images\AddinDesktop32.png</Image>
    <Author>Geological Survey Canada</Author>
    <Company>Government of Canada - Gouvernement du Canada</Company>
    <Date>5/27/2025 9:40:03 AM</Date>
    <Subject>Framework, Editing, Geodatabase, Geometry, Geology, Bedrock</Subject>
    <!-- Note subject can be one or more of these topics:
                    Content, Framework, Editing, Geodatabase, Geometry, Geoprocessing, Layouts, Map Authoring, Map Exploration -->
  </AddInInfo>
  <modules>
    <insertModule id="BedrockEditorPro_Module" className="BedrockModule" autoLoad="false" caption="GSC Bedrock Module">
      <!-- uncomment to have the control hosted on a separate tab-->
      <tabs>
        <tab id="BedrockEditorPro_Edit" caption="Bedrock Editor" keytip="tab key tip">
          <group refID="BedrockEditorPro_Templates" />
          <group refID="BedrockEditorPro_CreateEdit" />
          <group refID="BedrockEditorPro_View" />
          <group refID="BedrockEditorPro_Legend" />
          <group refID="BedrockEditorPro_Root" />
        </tab>
        <tab id="BedrockEditorPro_Manager" caption="Bedrock Manager" keytip="tab key tip">
          <group refID="BedrockEditorPro_Environment" />
          <group refID="BedrockEditorPro_Metadata" />
          <group refID="BedrockEditorPro_Load" />
        </tab>
      </tabs>
      <groups>
        <!--Roots-->
        <group id="BedrockEditorPro_Root" caption="" appearsOnAddInTab="false" keytip="Other">
          <button refID="BedrockEditorPro_Buttons_Button_RefreshSymbols" size="large" />
          <comboBox refID="BedrockEditorPro_Comboboxes_Combobox_SelectDataSource" />
          <comboBox refID="BedrockEditorPro_Comboboxes_Combobox_SelectParticipant" />
          <button refID="BedrockEditorPro_Controls_CoordSysDialog" size="large" />
          <button refID="BedrockEditorPro_DockPanes_Dockablewindow_CreateEdit_GeolineTemplate_ShowButton" size="large" />
          <button refID="BedrockEditorPro_DockPanes_Dock_CreateEdit_GeolineTemplate_ShowButton" size="large" />
          <button refID="BedrockEditorPro_ProWindows_Form_Load_StudyArea" size="large" />
          <button refID="BedrockEditorPro_ProWindows_Form_RefreshSymbols" size="large" />
        </group>
        <!--Templates-->
        <group id="BedrockEditorPro_Templates" caption="Templates" appearsOnAddInTab="false" keytip="Other">
          <button refID="BedrockEditorPro_Buttons_Button_CreateEdit_GeolineTemplate" size="large" />
          <button refID="BedrockEditorPro_Buttons_Button_CreateEdit_GeopointTemplate" size="large" />
          <button refID="BedrockEditorPro_Buttons_Button_CreateEdit_LabelTemplate" size="large" />
        </group>
        <!-- Create Edit -->
        <group id="BedrockEditorPro_CreateEdit" caption="Create/Validate" appearsOnAddInTab="false" keytip="CreateEdit">
          <button refID="BedrockEditorPro_Buttons_Button_CreateEdit_CreateMapUnits" size="large" />
          <button refID="BedrockEditorPro_Buttons_Button_CreateEdit_ValidateGeolineIntegrity" size="large" />
          <button refID="BedrockEditorPro_Buttons_Button_CreateEdit_QualityControl" size="large" />
        </group>
        <!--View-->
        <group id="BedrockEditorPro_View" caption="View" appearsOnAddInTab="false" keytip="View">
          <!-- host controls within groups -->
        </group>
        <!--Legend-->
        <group id="BedrockEditorPro_Legend" caption="Legend" appearsOnAddInTab="false" keytip="Legend">
          <button refID="BedrockEditorPro_Buttons_Button_Legend_ItemsModification" size="large" />
          <button refID="BedrockEditorPro_Buttons_Button_Legend_IntersectItemsWithStudyArea" size="large" />
          <button refID="BedrockEditorPro_Buttons_Button_Legend_ItemDescription" size="large" />
        </group>
        <!--Environment-->
        <group id="BedrockEditorPro_Environment" caption="Environment" appearsOnAddInTab="false" keytip="Enviromment">
          <button refID="BedrockEditorPro_ProWindows_Form_Environment_NewGeodatabase" size="large" />
          <!--<button refID="BedrockEditorPro_Buttons_Button_Environment_NewGeodatabase" size="large" />-->
          <button refID="BedrockEditorPro_Buttons_Button_Environment_CreateApplyTopologicalRules" size="large" />
          <button refID="BedrockEditorPro_Buttons_Button_Environment_AddProjectLayers" size="large" />
        </group>
        <!--Metadata-->
        <group id="BedrockEditorPro_Metadata" caption="Project Metadata" appearsOnAddInTab="false" keytip="Metadata">
          <!-- host controls within groups -->
        </group>
        <!--Load-->
        <group id="BedrockEditorPro_Load" caption="Load" appearsOnAddInTab="false" keytip="Load">
          <button refID="BedrockEditorPro_Buttons_Button_Load_StudyAreas" size="large" />
        </group>
      </groups>
      <controls>
        <!-- Root tools -->
        <button id="BedrockEditorPro_Buttons_Button_RefreshSymbols" caption="Refresh Symbols" className="BedrockEditorPro.Buttons.Button_RefreshSymbols" loadOnClick="true" smallImage="GenericRefresh16" largeImage="GenericRefresh32" keytip="Refresh">
          <tooltip heading="Editor">Refreshes the symbology of feature layers.<disabledText /></tooltip>
        </button>
        <comboBox id="BedrockEditorPro_Comboboxes_Combobox_SelectDataSource" caption="Source" keytip="Data Source Reference" className="BedrockEditorPro.Comboboxes.Combobox_SelectDataSource" itemWidth="140" extendedCaption="Extended Caption" isEditable="false" isReadOnly="true" resizable="true">
          <tooltip heading="Editor">Tooltip text<disabledText /></tooltip>
        </comboBox>
        <comboBox id="BedrockEditorPro_Comboboxes_Combobox_SelectParticipant" caption="Participant" keytip="Select a Project Participant" className="BedrockEditorPro.Comboboxes.Combobox_SelectParticipant" itemWidth="140" extendedCaption="Extended Caption" isEditable="false" isReadOnly="true" resizable="true">
          <tooltip heading="Editor">Tooltip text<disabledText /></tooltip>
        </comboBox>
        <!-- Create edit menu -->
        <button id="BedrockEditorPro_Buttons_Button_CreateEdit_GeolineTemplate" caption="Geoline Templates" keytip="Create Geoline Template" className="BedrockEditorPro.Buttons.Button_CreateEdit_GeolineTemplate" loadOnClick="true" smallImage="EditingEditLine16" largeImage="EditingEditLine32">
          <tooltip heading="Tooltip Heading">Tooltip text<disabledText /></tooltip>
        </button>
        <button id="BedrockEditorPro_Buttons_Button_CreateEdit_GeopointTemplate" caption="Geopoint Templates" keytip="Create Geopoint Template" className="BedrockEditorPro.Buttons.Button_CreateEdit_GeopointTemplate.cs" loadOnClick="true" smallImage="PointOnTheMap16" largeImage="PointOnTheMap32">
          <tooltip heading="Tooltip Heading">Tooltip text<disabledText /></tooltip>
        </button>
        <button id="BedrockEditorPro_Buttons_Button_CreateEdit_LabelTemplate" caption="Label Templates" keytip="Create Label Template" className="BedrockEditorPro.Buttons.Button_CreateEdit_LabelTemplate" loadOnClick="true" smallImage="ElementPolygonText16" largeImage="ElementPolygonText32">
          <tooltip heading="Tooltip Heading">Tooltip text<disabledText /></tooltip>
        </button>
        <button id="BedrockEditorPro_Buttons_Button_CreateEdit_CreateMapUnits" caption="Create Map Units" keytip="Create Map Unit Polygons" className="BedrockEditorPro.Buttons.Button_CreateEdit_CreateMapUnits" loadOnClick="true" smallImage="EditingReplaceGeometry16" largeImage="EditingReplaceGeometry32">
          <tooltip heading="Tooltip Heading">Tooltip text<disabledText /></tooltip>
        </button>
        <button id="BedrockEditorPro_Buttons_Button_CreateEdit_ValidateGeolineIntegrity" caption="Validate Geoline Integrity" keytip="Geoline validation tool." className="BedrockEditorPro.Buttons.Button_CreateEdit_ValidateGeolineIntegrity" loadOnClick="true" smallImage="EditingExplode16" largeImage="EditingExplode32">
          <tooltip heading="Tooltip Heading">Tooltip text<disabledText /></tooltip>
        </button>
        <button id="BedrockEditorPro_Buttons_Button_CreateEdit_QualityControl" caption="Quality Control Tools" keytip="Quality Control Tools" className="BedrockEditorPro.Buttons.Button_CreateEdit_QualityControl.cs" loadOnClick="true" smallImage="ValidateAll16" largeImage="ValidateAll32">
          <tooltip heading="Tooltip Heading">Tooltip text<disabledText /></tooltip>
        </button>
        <button id="BedrockEditorPro_Buttons_Button_Legend_ItemsModification" caption="Items Modification" keytip="Manage Legend Items" className="BedrockEditorPro.Buttons.Button_Legend_ItemsModification" loadOnClick="true" smallImage="ItemThumbnailCreate16" largeImage="ItemThumbnailCreate32">
          <tooltip heading="Tooltip Heading">Tooltip text<disabledText /></tooltip>
        </button>
        <button id="BedrockEditorPro_Buttons_Button_Legend_IntersectItemsWithStudyArea" caption="Intersect with Study Areas" keytip="Intersect Legend Items with Study Areas" className="BedrockEditorPro.Buttons.Button_Legend_IntersectItemsWithStudyArea" loadOnClick="true" smallImage="Layer_Intersect16" largeImage="Layer_Intersect32">
          <tooltip heading="Tooltip Heading">Tooltip text<disabledText /></tooltip>
        </button>
        <button id="BedrockEditorPro_Buttons_Button_Legend_ItemDescription" caption="Items Description" keytip="Manage Legend Item Descriptions" className="BedrockEditorPro.Buttons.Button_Legend_ItemDescription" loadOnClick="true" smallImage="Grouping16" largeImage="Grouping32">
          <tooltip heading="Tooltip Heading">Tooltip text<disabledText /></tooltip>
        </button>
        <button id="BedrockEditorPro_Buttons_Button_Environment_CreateApplyTopologicalRules" caption="Create and Apply Topological Rules" keytip="Create Topology Layer" className="BedrockEditorPro.Buttons.Button_Environment_CreateApplyTopologicalRules" loadOnClick="true" smallImage="EditingReshapeTopologyEdgeTool16" largeImage="EditingReshapeTopologyEdgeTool32">
          <tooltip heading="Environment">Creates a topological dataset (GEO_TOPO) inside the project geodatabase.<disabledText /></tooltip>
        </button>
        <button id="BedrockEditorPro_Buttons_Button_Environment_AddProjectLayers" caption="Add Project Layers" keytip="Add project related layers" className="BedrockEditorPro.Buttons.Button_Environment_AddProjectLayers" loadOnClick="true" smallImage="LayerImportSymbology16" largeImage="LayerImportSymbology32">
          <tooltip heading="Environment">Adds project layers with preloaded and symbolized data.<disabledText /></tooltip>
        </button>
        <button id="BedrockEditorPro_Buttons_Button_Load_StudyAreas" caption="Study Areas" keytip="Manage Project Study Areas" className="BedrockEditorPro.Buttons.Button_Load_StudyAreas" loadOnClick="true" smallImage="ReshapeMapFrameRectangle16" largeImage="ReshapeMapFrameRectangle32">
          <tooltip heading="Load">Prompts a form to add or modify project study areas.<disabledText /></tooltip>
        </button>
        <button id="BedrockEditorPro_ProWindows_Form_Environment_NewGeodatabase" caption="New Geodatabase" keytip="Create New Project Geodatabase." className="BedrockEditorPro.ProWindows.Show_Form_Environment_NewGeodatabase" loadOnClick="true" smallImage="GeodatabaseAdd16" largeImage="GeodatabaseAdd32">
          <tooltip heading="Environment">Create a new project file geodatabase<disabledText /></tooltip>
        </button>
      </controls>
      <dockPanes>
        <dockPane id="BedrockEditorPro_DockPanes_Dock_CreateEdit_GeolineTemplate" caption="Dock _CreateEdit_GeolineTemplate" className="BedrockEditorPro.DockPanes.Dock_CreateEdit_GeolineTemplateViewModel" dock="group" dockWith="esri_core_projectDockPane">
          <content className="BedrockEditorPro.DockPanes.Dock_CreateEdit_GeolineTemplateView" />
        </dockPane>
      </dockPanes>
    </insertModule>
  </modules>
</ArcGIS>