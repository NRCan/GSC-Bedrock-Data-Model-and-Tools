<UserControl x:Class="BedrockEditorPro.Controls.BrowseButton"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:BedrockEditorPro.Controls"
             xmlns:localize="clr-namespace:BedrockEditorPro.Properties"
             xmlns:extensions="clr-namespace:ArcGIS.Desktop.Extensions;assembly=ArcGIS.Desktop.Extensions"
             xmlns:controls="clr-namespace:ArcGIS.Desktop.Framework.Controls;assembly=ArcGIS.Desktop.Framework"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    
    <Button Style="{DynamicResource Esri_Button}" Margin="5" VerticalAlignment="Center" HorizontalContentAlignment="Right">
        <Button.Content>
            <Border>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Image Source="{Binding BrowserButtonImage}"  Margin="5" HorizontalAlignment="Center" Width="16" Height="16"/>
                    <TextBlock Text="{x:Static localize:Resources.GenericButtonBrowse}" VerticalAlignment="Center" Margin="5,5,5,5" />
                </StackPanel>
            </Border>
        </Button.Content>

    </Button>
</UserControl>
