<UserControl x:Class="BedrockEditorPro.Controls.BrowseButton"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:BedrockEditorPro.Controls"
             xmlns:localize="clr-namespace:BedrockEditorPro.Properties"
             xmlns:controls="clr-namespace:ArcGIS.Desktop.Framework.Controls;assembly=ArcGIS.Desktop.Framework"
             xmlns:extensions="clr-namespace:ArcGIS.Desktop.Extensions;assembly=ArcGIS.Desktop.Extensions"
             mc:Ignorable="d" 
             d:DesignHeight="35" d:DesignWidth="100">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <extensions:DesignOnlyResourceDictionary Source="pack://application:,,,/ArcGIS.Desktop.Framework;component/XamlImages.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Button x:Name="buttonBrowse" Style="{DynamicResource Esri_Button}" Margin="5" VerticalAlignment="Center" HorizontalContentAlignment="Right"
            Command="{Binding OpenBrowseWindow}">
        <Button.Content>
            <Border>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Image Source="{DynamicResource FolderOpenState16}"  Margin="3" HorizontalAlignment="Center" Width="16" Height="16"/>
                    <TextBlock Text="{x:Static localize:Resources.GenericButtonBrowse}" VerticalAlignment="Center" Margin="5,5,5,5" />
                </StackPanel>
            </Border>
        </Button.Content>

    </Button>
</UserControl>
