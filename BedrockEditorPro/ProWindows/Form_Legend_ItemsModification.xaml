<controls:ProWindow x:Class="BedrockEditorPro.ProWindows.Form_Legend_ItemsModification"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:controls="clr-namespace:ArcGIS.Desktop.Framework.Controls;assembly=ArcGIS.Desktop.Framework"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:extensions="clr-namespace:ArcGIS.Desktop.Extensions;assembly=ArcGIS.Desktop.Extensions"
        xmlns:local="clr-namespace:BedrockEditorPro.Properties"
        xmlns:bedrockcontrols="clr-namespace:BedrockEditorPro.Controls"
        xmlns:layerControls="clr-namespace:ArcGIS.Desktop.Internal.Mapping.CommonControls.LayerControls;assembly=ArcGIS.Desktop.Mapping"
        mc:Ignorable="d"
        ResizeMode="NoResize" 
        Title="{x:Static local:Resources.FormLegendItemsModificationTitle}" Height="800" Width="1200"
        WindowStartupLocation="CenterOwner">
    
    <controls:ProWindow.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <extensions:DesignOnlyResourceDictionary Source="pack://application:,,,/ArcGIS.Desktop.Framework;component\Themes\Default.xaml"/>
                <extensions:DesignOnlyResourceDictionary Source="/BedrockEditorPro;component/BedrockStyle.xaml"/>
                <extensions:DesignOnlyResourceDictionary Source="pack://application:,,,/ArcGIS.Desktop.Framework;component/XamlImages.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </controls:ProWindow.Resources>

    <Grid Style="{DynamicResource BedrockGrid}" Margin="10" VerticalAlignment="Top">

        <Grid.RowDefinitions>

            <!--Select legend table layer-->
            <RowDefinition Height="65"/>

            <!--Select legend item-->
            <RowDefinition Height="65"/>

            <!--Command buttons-->
            <RowDefinition Height="25"/>
            <RowDefinition Height="25"/>

        </Grid.RowDefinitions>

        <!--Legend table view-->
        <StackPanel Grid.Row="0" >
            <TextBlock Text="{x:Static local:Resources.FormLegendTableView}" HorizontalAlignment="Left" Style="{DynamicResource Esri_TextBlockDockPaneHeader}"/>
            <ComboBox x:Name="LegendViewCombobox" Width="200" HorizontalAlignment="Left" Style="{DynamicResource BedrockTextboxInputs}" Margin="0,10,0,0" Height="22" VerticalContentAlignment="Center" 
                                     ItemsSource="{Binding Path=LegendTables}" SelectedIndex="{Binding Path=LegendSelectedTableIndex}">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Name}" />
                        </StackPanel>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
        </StackPanel>

        <!--Legend items-->
        <StackPanel Grid.Row="1" >
            <Label Content="{x:Static local:Resources.FormLegendItems}" HorizontalAlignment="Left" Margin="-5,0,0,-5" Style="{DynamicResource BedrockButtonLabel}"/>
            <ComboBox x:Name="LegendItemCombobox" Width="200" HorizontalAlignment="Left" Style="{DynamicResource BedrockTextboxInputs}" Margin="0,0,0,10" Height="22" VerticalContentAlignment="Center" 
                                     ItemsSource="{Binding Path=LegendItems}" SelectedIndex="{Binding Path=LegendSelectedItemIndex}"/>
        </StackPanel>

        <!--Run-->
        <Button Grid.Row="2" Margin="0"
            Style="{DynamicResource Esri_Button}" HorizontalAlignment="Left" Width="75"
            Command="{Binding RunTool}">
            <Button.Content>
                <Border>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Image Source="{DynamicResource GenericRun16}"  Margin="2" HorizontalAlignment="Center" Width="16" Height="16"/>
                        <TextBlock Text="{x:Static local:Resources.GenericButtonRun}" VerticalAlignment="Center" Margin="3"/>
                    </StackPanel>
                </Border>
            </Button.Content>
        </Button>

    </Grid>
</controls:ProWindow>
