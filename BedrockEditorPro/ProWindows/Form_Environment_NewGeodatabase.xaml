<controls:ProWindow x:Class="BedrockEditorPro.ProWindows.Form_Environment_NewGeodatabase"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:controls="clr-namespace:ArcGIS.Desktop.Framework.Controls;assembly=ArcGIS.Desktop.Framework"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:BedrockEditorPro.Properties"
        xmlns:bedrockcontrols="clr-namespace:BedrockEditorPro.Controls"
        xmlns:extensions="clr-namespace:ArcGIS.Desktop.Extensions;assembly=ArcGIS.Desktop.Extensions" 
        mc:Ignorable="d"
        ResizeMode="NoResize" Topmost="False"
        Title="{x:Static local:Resources.FormEnvironmentNewGeodatabaseTitle}" MaxHeight="285" Width="500"
        WindowStartupLocation="CenterOwner">
    
    <controls:ProWindow.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <extensions:DesignOnlyResourceDictionary Source="pack://application:,,,/ArcGIS.Desktop.Framework;component\Themes\Default.xaml"/>
                <extensions:DesignOnlyResourceDictionary Source="/BedrockEditorPro;component/BedrockStyle.xaml"/>
                <extensions:DesignOnlyResourceDictionary Source="pack://application:,,,/ArcGIS.Desktop.Framework;component/XamlImages.xaml"/>
            </ResourceDictionary.MergedDictionaries>

        </ResourceDictionary>
    </controls:ProWindow.Resources>
    <Grid Style="{DynamicResource BedrockGrid}" Margin="10" VerticalAlignment="Top">

        <!--Create Project GDB from Master Schema-->
        <Grid.RowDefinitions>
            <!--Label italic for warning-->
            <RowDefinition Height="25"/>

            <!--beta testing-->
            <RowDefinition Height="20"/>
            <RowDefinition Height="20"/>
            <RowDefinition Height="10"/>
            
            <!--output-->
            <RowDefinition Height="20"/>
            <RowDefinition Height="20"/>
            <RowDefinition Height="5"/>
            
            <!--Projection-->
            <RowDefinition Height="20"/>
            <RowDefinition Height="20"/>
            <RowDefinition Height="20"/>
            <!--Command buttons-->
            <RowDefinition Height="35"/>

        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="100"/>
        </Grid.ColumnDefinitions>

        <Label x:Name="NewGeodatabaseVersionLabel" Grid.Row="0" FontStyle="Italic" Margin="-5,0,0,-5"
           Content="{x:Static local:Resources.FormEnvironmentNewGeodatabaseNote}" 
           Style="{DynamicResource BedrockButtonLabel}" />

        <!--For beta testing-->
        <Label x:Name="NewGeodatabaseVersionLabelBetaTesting" Grid.Row="1" Margin="-5,0,0,-5"
           Content="{x:Static local:Resources.FormEnvironmentNewGeodatabaseBetaOptions}" 
           Style="{DynamicResource BedrockButtonLabel}" />
        
        <StackPanel Orientation="Horizontal" Grid.Row="2">
            
            <RadioButton GroupName="BetaTesting" Margin="0,5,10,0" Content="{x:Static local:Resources.FormEnvironmentNewGeodatabaseV300}" IsChecked="{Binding Path=Version300Checkbox}"></RadioButton>
            <RadioButton GroupName="BetaTesting" Margin="0,5,0,0" Content="{x:Static local:Resources.FormEnvironmentNewGeodatabaseV210}" IsChecked="{Binding Path=Version210Checkbox}"></RadioButton>
        </StackPanel>


        <!--Output-->
        <Label Grid.Row="4" Content="{x:Static local:Resources.FormEnvironmentNewGeodatabaseInput2}" Style="{DynamicResource BedrockButtonLabel}" Margin="-5,0,0,-5" />
        <TextBox Grid.Row="5" Style="{DynamicResource BedrockTextboxInputs}" Margin="0,0,0,-5" Height="22" VerticalContentAlignment="Center"
                Text="{Binding Path=OutputGDBPath}"/>
        <bedrockcontrols:BrowseButton x:Name="NewGeodatabaseOutputGDBBrowse" Grid.Row="5" Grid.Column="1"  />

        <!--Projection-->
        <Label Grid.Row="7" Content="{x:Static local:Resources.FormEnvironmentNewGeodatabaseInput3}" Style="{DynamicResource BedrockButtonLabel}" Margin="-5,0,0,-5" />
        <TextBox Grid.Row="8" Style="{DynamicResource BedrockTextboxInputs}" Margin="0,0,0,-5" Height="22" VerticalContentAlignment="Center"
                Text="{Binding Path=OutputSRName}"/>
        <Button Grid.Row="8" Grid.Column="1" Style="{DynamicResource Esri_Button}"  Margin="10,-5,5,-10" VerticalAlignment="Center" HorizontalContentAlignment="Right"
            Command="{Binding OpenProjectionBrowse}">
            <Button.Content>
                <Border>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Image Source="{DynamicResource CoordinateSystem16}"  Margin="2" HorizontalAlignment="Center" Width="16" Height="16"/>
                        <TextBlock Text="{x:Static local:Resources.GenericButtonBrowse}" VerticalAlignment="Center" Margin="3"/>
                    </StackPanel>
                </Border>
            </Button.Content>
        </Button>

        <!--Save/Cancel-->
        <Button Grid.Row="10" Margin="0,10,0,0"
            Style="{DynamicResource Esri_Button}" HorizontalAlignment="Left" Width="75"
            Command="{Binding RunTool}">
            <Button.Content>
                <Border>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Image Source="{DynamicResource GenericRun16}"  Margin="2" HorizontalAlignment="Center" Width="16" Height="16"/>
                        <TextBlock Text="{x:Static local:Resources.GenericButtonRun}" VerticalAlignment="Center" Margin="3"/>
                    </StackPanel>
                </Border>
            </Button.Content>
        </Button>
        
        <!--<bedrockcontrols:CancelButton Grid.Row="7" />-->

        <controls:WaitingCursorControl Grid.ColumnSpan="2" Grid.RowSpan="10" Visibility="{Binding Path=WaitingCursorVisibility}" />
        
    </Grid>

</controls:ProWindow>
