<controls:ProWindow x:Class="BedrockEditorPro.CustomDialogs.SymbolStyleDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:controls="clr-namespace:ArcGIS.Desktop.Framework.Controls;assembly=ArcGIS.Desktop.Framework"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:extensions="clr-namespace:ArcGIS.Desktop.Extensions;assembly=ArcGIS.Desktop.Extensions"
        xmlns:ui="clr-namespace:BedrockEditorPro.CustomDialogs"
        xmlns:local="clr-namespace:BedrockEditorPro.Properties"
        xmlns:mapping="clr-namespace:ArcGIS.Desktop.Mapping.Controls;assembly=ArcGIS.Desktop.Mapping"
        xmlns:common="clr-namespace:BedrockEditorPro.Utilities"
        mc:Ignorable="d" ResizeMode="CanMinimize"
        Title="{x:Static local:Resources.DialogSymbolStyleTitle}" Height="500" Width="300"
        WindowStartupLocation="CenterOwner">
    
    <controls:ProWindow.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <extensions:DesignOnlyResourceDictionary Source="pack://application:,,,/ArcGIS.Desktop.Framework;component\Themes\Default.xaml"/>
                <ResourceDictionary Source="/BedrockEditorPro;component/CustomDialogs/SymbolItemStyles.xaml"></ResourceDictionary>
                <extensions:DesignOnlyResourceDictionary Source="/BedrockEditorPro;component/BedrockStyle.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <ui:SymbolStyleItemTemplateSelector x:Key="SymbolStyleItemTemplateSelector" 
                                               SymbolStyleItemTemplate="{StaticResource SymbolStyleItemTemplate}">
            </ui:SymbolStyleItemTemplateSelector>

        </ResourceDictionary>
    </controls:ProWindow.Resources>
    <Grid>
        <Grid.Resources>
            <ResourceDictionary>
                <ResourceDictionary.MergedDictionaries>
                    <extensions:DesignOnlyResourceDictionary Source="pack://application:,,,/ArcGIS.Desktop.Framework;component\Themes\Default.xaml"/>
                </ResourceDictionary.MergedDictionaries>

            </ResourceDictionary>
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="400"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>


        <ListBox Grid.Row="0" Height="400" 
                 ItemsSource="{Binding SymbolStyleItemCollection}"                  
                    ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                    ScrollViewer.VerticalScrollBarVisibility="Visible"
                    SelectedItem="{Binding SelectedItem}"     
                    ItemTemplateSelector="{StaticResource SymbolStyleItemTemplateSelector}"
                    Margin ="5">
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
        </ListBox>

        <Button Grid.Row="1" Height="25" Content="OK" Click="Close_OnClick" HorizontalAlignment="Left" x:Name="OK" Style="{DynamicResource Esri_Button}"></Button>

    </Grid>
</controls:ProWindow>
