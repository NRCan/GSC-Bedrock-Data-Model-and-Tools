<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--Warning: Margin setting in here doesn't work-->

    <!--Custom styles for BedrockEditorPro-->
    <Style x:Key="BedrockTextboxInputs" TargetType="TextBox">
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="VerticalAlignment" Value="Stretch"/>
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Height" Value="25"/>
    </Style>

    <Style x:Key="BedrockGrid" TargetType="Grid">
        <!--Need to be added in xaml, doesn't work from style file-->
        <!--<Setter Property="Margin" Value="10,10,10,10"/>-->
    </Style>

    <Style x:Key="BedrockButtonSave" TargetType="Button">
        <Setter Property="Width" Value="100" />
        <Setter Property="HorizontalAlignment" Value="Left"/>
        <Setter Property="VerticalAlignment" Value="Stretch"/>
    </Style>

    <Style x:Key="BedrockButtonCancel" TargetType="Button">
        <Setter Property="Margin" Value="110,0,10,0"/>
        <Setter Property="Width" Value="100" />
        <Setter Property="HorizontalAlignment" Value="Left"/>
        <Setter Property="VerticalAlignment" Value="Stretch"/>
    </Style>

    <Style x:Key="BedrockButtonLabel" TargetType="Label">
        <Setter Property="Margin" Value="0"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
</ResourceDictionary>